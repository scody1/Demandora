# ==============================================================================
# DEMANDORA — Environment Configuration Example
# Copy this file to .env to configure local environment variables.
# ==============================================================================

# Backend Service Configuration
HOST=127.0.0.1
PORT=8000
DEMANDORA_WORKERS=8

# Cache Subsystem (Defaults to backend/cache_data/forecast_cache.db)
DEMANDORA_CACHE_DIR=backend/cache_data
DEMANDORA_CACHE_DB=forecast_cache.db

# Frontend Service Configuration
VITE_API_URL=http://localhost:8000

# Optional Generative AI Integration (for automated executive demand commentary)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
